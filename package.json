{
    "name": "live-translation",
    "version": "1.0.0",
    "description": "Real-time French to English translation overlay for WhatsApp calls",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "build:electron": "node electron-build.js",
        "electron": "npm run build:electron && cross-env NODE_ENV=development electron dist-electron/main.js",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run electron\"",
        "electron:build": "cross-env ELECTRON_BUILD=true npm run build && npm run build:electron && electron-builder"
    },
    "keywords": [
        "electron",
        "nextjs",
        "translation",
        "deepgram",
        "deepl"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@deepgram/sdk": "^3.5.0",
        "@google/generative-ai": "^0.24.1",
        "deepl-node": "^1.12.0",
        "edge-tts": "^1.0.1",
        "next": "^15.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3",
        "wait-on": "^7.2.0"
    },
    "optionalDependencies": {
        "bufferutil": "^4.1.0",
        "utf-8-validate": "^6.0.6"
    }
}
