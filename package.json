{
    "name": "live-translation",
    "version": "1.0.0",
    "description": "Real-time French to English translation overlay for WhatsApp calls",
    "main": "electron/dist/main.js",
    "config": {
        "node_gyp_msvs_version": "2026"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "build:electron": "tsc -p electron/tsconfig.json",
        "electron": "npm run build:electron && cross-env NODE_ENV=development electron electron/dist/main.js",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run electron\"",
        "electron:build": "cross-env ELECTRON_BUILD=true npm run build && npm run build:electron && electron-builder",
        "clean": "rm -rf electron/dist .next out release"
    },
    "keywords": [
        "electron",
        "nextjs",
        "translation"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "electron-store": "^11.0.2",
        "next": "^15.0.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "smart-whisper": "*",
        "wavefile": "^11.0.0"
    },
    "devDependencies": {
        "@electron/rebuild": "^3.6.0",
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.45",
        "@types/react-dom": "^18.2.18",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "electron-rebuild": "^3.2.9",
        "node-gyp": "^12.1.0",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.3",
        "wait-on": "^7.2.0"
    },
    "optionalDependencies": {
        "bufferutil": "^4.1.0",
        "utf-8-validate": "^6.0.6"
    },
    "build": {
        "asar": true,
        "asarUnpack": [
            "**/node_modules/smart-whisper/**/*",
            "electron/bin/**/*"
        ],
        "extraResources": [
            {
                "from": "electron/bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            }
        ]
    }
}
